{
  "name": "git-ingest",
  "version": "2.0.0",
  "description": "AI-powered Git repository daily report generator, interactive TUI, and scheduling suite",
  "type": "module",
  "bin": {
    "git-ingest": "./dist/src/index.js"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "ts-node-esm src/index.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify-docs": "npm run build && node dist/src/utils/verify.js",
    "install-skill": "npm run build && node dist/src/index.js --install-skill"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
