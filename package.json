{
  "name": "ingest",
  "version": "2.0.0",
  "description": "AI-powered Git repository daily report generator, interactive TUI, and scheduling suite",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "ingest": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "start": "node dist/src/index.js",
    "dev": "ts-node-esm src/index.ts",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify-docs": "npm run build && node dist/src/utils/verify.js",
    "install-skill": "npm run build && node dist/src/index.js --install-skill"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}

